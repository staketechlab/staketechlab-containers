# Copy of the environment used by docker-compose.yml. Compose reads .env
# from this directory for port interpolation AND passes it to the container
# (env_file), so variables here are visible to the app itself.

# Host port the dashboard listens on (default: 3000).
HOMEPAGE_PORT=3000

# Anti DNS-rebinding allow-list. Homepage answers HTTP 400 "Host validation
# failed" to ANY host not listed here — localhost included. The installer
# pre-fills this with localhost + your LAN IP + the chosen port. Add
# hostnames here as you expose it (reverse proxy, public domain, Tailscale):
#   HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000,dashboard.example.com,192.168.1.10:3000
# After editing: docker compose up -d (recreate) for it to take effect.
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
